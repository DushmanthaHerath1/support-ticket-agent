# ==============================================================================
# Frontend .gitignore (React, Vite, Tailwind CSS, pnpm/npm/yarn)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Production builds
dist/
dist-ssr/
build/
out/
.output/

# Environment files and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/

# Tooling and build caches
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.oxlint_cache/
.turbo/
.next/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs, Editors, and Workspace
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary and local overrides
*.local
*.tmp
*.bak
